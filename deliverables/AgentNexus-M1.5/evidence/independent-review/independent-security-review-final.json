  "findings": [
    {
      "id": "IR15-01",
      "priority": "P2",
      "title": "Peer monitoring and output competed for a single native RPC",
      "status": "CODE_CLOSED_LIMITED",
      "files": [
        "src/agentnexus/bootstrap/session.ts",
        "src/agentnexus/bootstrap/supervisor.ts"
      ],
      "resolution": "A bounded shared RPC serial gate now covers read/write/peer. Interleaved monitoring and output complete without M14_NATIVE_BACKPRESSURE.",
      "verification": "Independent SIMULATED interleave probe."
    },
    {
      "id": "IR15-02",
      "priority": "P2",
      "title": "Completed prepared-process maps were never retired",
      "status": "CODE_CLOSED_LIMITED",
      "files": [
        "src/agentnexus/bootstrap/supervisor.ts",
        "src/agentnexus/production/windows-supervisor.ts"
      ],
      "resolution": "Terminal root/Job/output observations retire native helpers and in-memory maps; uncertain or unstarted entries remain held. Five consecutive settled model runs complete. Durable resource claims are not released by retirement.",
      "verification": "Independent SIMULATED lifecycle probe; no real Worker lifecycle claim."
    },
    {
      "id": "IR15-03",
      "priority": "P2",
      "title": "Config pin case handling and role config placement could prevent startup",
      "status": "CODE_CLOSED_LIMITED",
      "files": [
        "src/agentnexus/bootstrap/config.ts",
        "src/agentnexus/bootstrap/entry.ts"
      ],
      "resolution": "All helpers share normalized external-config hash substitution. Config must be outside code_root, avoiding cross-role self-referential source manifests. Operator SID is distinct from Host/Worker.",
      "verification": "Independent config pin models plus static entry-point review."
    },
    {
      "id": "IR15-04",
      "priority": "P1",
      "title": "A generic PowerShell fingerprint did not identify the enrolled Launcher instance",
      "status": "CODE_CLOSED_OS_QUALIFICATION_PENDING",
      "files": [
        "src/agentnexus/bootstrap/launcher-proof.ts",
        "src/agentnexus/bootstrap/runtime.ts"
      ],
      "resolution": "A private enrolled Launcher key signs a fresh challenge bound to both actual pipe process tuples, configuration/source/helper hashes and expiry before the session key is sent.",
      "verification": "Five independent signature/challenge models; actual key ACL and cross-account identity qualification remain BLOCKED."
    },
    {
      "id": "IR15-05",
      "priority": "P1",
      "title": "Source, ACL and private-storage object coverage was incomplete",
      "status": "CODE_CLOSED_OS_QUALIFICATION_PENDING",
      "files": [
        "src/agentnexus/bootstrap/config.ts",
        "src/agentnexus/bootstrap/permissions.ts",
        "src/agentnexus/production/windows/BootstrapNative.cs"
      ],
      "resolution": "Root domains are disjoint; the complete source inventory requires individual immutable file pins and semantic ACL checks including DELETE_CHILD. Node/PowerShell parent directories are pinned. Up to four bounded pin batches are used and all leases are rechecked; losing one revokes production. Private storage uses a bounded root-relative owner/DACL/reparse/hardlink inspection.",
      "verification": "Four permission and six config/batch models plus native static review. Storage inspection is explicitly a security snapshot under trusted mutators, not an atomic content snapshot. Positive deployed ACL enforcement is NOT_RUN."
    },
    {
      "id": "IR15-06",
      "priority": "P2",
      "title": "Crash-left writer locks prevented reaching ledger recovery",
      "status": "CODE_CLOSED_LIMITED",
      "files": [
        "src/agentnexus/bootstrap/runtime.ts",
        "src/agentnexus/storage.ts"
      ],
      "resolution": "After successful OS/storage attestation, Bootstrap invokes the existing explicit owner-death lock recovery before opening stores, preserving the abandoned lock evidence; uncertain or reused/live PIDs still deny.",
      "verification": "One REAL_OS_CURRENT_ACCOUNT_STORAGE_PRIMITIVE sequence reproduced STORE_LOCKED after a child exits without close, then recovered and reopened its isolated store. No production Host restart is claimed."
    },
    {
      "id": "IR15-07",
      "priority": "P1",
      "title": "Runtime capabilities could remain ACTIVE after the one-operation lifetime",
      "status": "CODE_CLOSED_LIMITED",
      "files": [
        "src/agentnexus/bootstrap/runtime.ts",
        "src/agentnexus/production/file-broker.ts"
      ],
      "resolution": "The request finalizer revokes endpoint/runtime capabilities and drops bound channels. Production FileBroker is wired to live OS identity rechecks before and after the audit barrier. Revocation after the barrier prevents the native read and keeps the nonce UNKNOWN_QUARANTINED.",
      "verification": "Independent injected liveness-failure model and static production wiring review."
    },
    {
      "id": "IR15-08",
      "priority": "P2",
      "title": "Broker quota had no trusted owner-release acknowledgement path",
      "status": "CODE_CLOSED_OS_QUALIFICATION_PENDING",
      "files": [
        "src/agentnexus/production/broker.ts",
        "src/agentnexus/bootstrap/runtime.ts",
        "src/agentnexus/production/authority.ts"
      ],
      "resolution": "A signed owner receipt follows consumed Host release authorization, closure and independent adjudication. Broker checks its own complete proof, original intent/boot and five resources before durably marking RELEASED. Reuse updates only RELEASED projections with revision+1 in the original atomic claim transaction.",
      "verification": "Six independent release models reject incomplete proofs/wrong keys/intents/resources and accept one idempotent receipt. No genuine production release is qualified."
    },
    {
      "id": "IR15-09",
      "priority": "P1",
      "title": "Suspended Worker creation needed a durable pre-prepare gate",
      "status": "CODE_CLOSED_LIMITED",
      "reported_by": "Author final self-review; independently re-reviewed",
      "files": [
        "src/agentnexus/bootstrap/reservations.ts",
        "src/agentnexus/bootstrap/runtime.ts",
        "src/agentnexus/bootstrap/supervisor.ts",
        "src/agentnexus/production/authority.ts"
      ],
      "resolution": "PREPARING and REQUESTED audit commit/flush precede supervisor.prepare, with live Feature/store fences. Prepared ownership transfers in the original Permit/Approval/resource transaction. Untransferred or cross-boot uncertainty stays quarantined. Disabled Launcher rejects PREPARE/AUTHORIZE/START before native preparation.",
      "verification": "Three selected SIMULATED tests independently rerun, covering zero native preparations on disable/audit failure, transaction rollback and restart quarantine. Real pre-Permit OS owner recovery remains BLOCKED."
    }
  ],
  "unresolved_p0_p1_code_findings": [],
  "final_new_scope_reviews": [
    "Finite file digest input is bounded to 4KiB and requires both the original signed execution Grant and an exact signed FileGrant, plus approved content hash. Independent file-input models reject cross-operation/resource/path/epoch, stale permits and byte/argument mutations.",
    "Native-reported OS version must equal profile.os_version. Profile accessible/read_only paths are exactly code_root and the Node runtime directory. Positive native attestation remains separate OS evidence.",
    "CPU qualification launches runtime and fixtures from an isolated complete source copy and records the actual copied source manifest. Cumulative user CPU and wall termination are distinguished; production_qualified stays false. Reviewer did not run CPU busy loops."
  ],
